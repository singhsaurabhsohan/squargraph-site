{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squargraph-site",
  "compatibility_date": "2026-06-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/assets/videos/*",
      "/api/ratings"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "workers/site-media.js"
}
