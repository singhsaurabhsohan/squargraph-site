{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "squargraph-site",
  "compatibility_date": "2026-06-03",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/assets/videos/*",
      "/api/ratings",
      "/os*",
      "/enterprise*",
      "/studio-app*",
      "/studio/app*",
      "/create*",
      "/design*",
      "/photo*",
      "/motion*",
      "/cinema*",
      "/cgi*",
      "/watermark*",
      "/cloud*"
    ]
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "workers/site-media.js"
}
